# ---------------------------------------------------------------------------
# Copy to `.env.local` and fill in. Everything here is validated at startup by
# `src/schemas/env.ts` — a missing or malformed required variable fails the
# build loudly instead of surfacing as `undefined` at runtime.
#
# Only `NEXT_PUBLIC_`-prefixed variables reach the browser bundle. Anything
# else stays server-only (see docs/conventions.md, "Environment variables").
# ---------------------------------------------------------------------------

# Base URL the *server* uses to reach the backend. Server-only, so it may be an
# internal address the browser cannot resolve (a service name, private DNS).
#
# The default points at dummyjson.com so a fresh clone runs and the catalog
# reference feature shows real data. Replace it with your API — the response
# shapes are validated by `src/schemas/*`, so a mismatch fails loudly at the
# boundary instead of leaking `undefined` into components.
API_URL=https://dummyjson.com

# Base URL the *browser* uses to reach the same backend. Usually identical to
# API_URL; it exists separately because API_URL must never be inlined into the
# bundle. See docs/api-layer.md ("Two base URLs, one client").
NEXT_PUBLIC_API_URL=https://dummyjson.com

# Public origin of this app. Required on the server to build absolute URLs for
# server-side fetches and for metadata/sitemap generation.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Toggles the TanStack Query devtools panel in the browser.
NEXT_PUBLIC_ENABLE_DEVTOOLS=true

# ---------------------------------------------------------------------------
# Sentry — entirely optional. With no DSN the SDK stays inert and the template
# runs normally, so a fresh clone needs no Sentry account (see docs/auth.md and
# the "Error reporting" section of docs/conventions.md).
# Swap the DSN for a self-hosted Sentry or GlitchTip instance and nothing else
# in the code has to change.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_SENTRY_DSN=
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=
# Fraction of transactions traced in production, 0..1.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
